generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "js"
  outputFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  id         String      @id @default(uuid())
  address    String      @unique
  owner_id   String?
  type       AccountType
  created_at DateTime    @default(now())

  users users? @relation(fields: [owner_id], references: [id]) // ← add this

  ledger_entries    ledger_entries[]
  transactions_from transactions[]   @relation("account_from")
  transactions_to   transactions[]   @relation("account_to")
}

model Session {
  id         String   @id @default(uuid())
  user       users    @relation(fields: [userId], references: [id])
  created_at DateTime @default(now())
  expires_at DateTime
  userId     String
}

model login_attempts {
  id         String   @id @default(uuid())
  phone      String
  created_at DateTime @default(now())
  expires_at DateTime
  attempts   Int      @default(0)
}

model signup_attempts {
  id         String   @id @default(uuid())
  phone      String
  created_at DateTime @default(now())
  expires_at DateTime
  attempts   Int      @default(0)
}

model audit_log {
  id          Int      @id @default(autoincrement())
  table_name  String
  operation   String
  old_data    Json?
  new_data    Json?
  executed_at DateTime @default(now())
}

model ledger_entries {
  id String @id @default(uuid())

  transaction_id String
  account_id     String

  debit  Int @default(0)
  credit Int @default(0)

  created_at DateTime @default(now())

  transactions transactions @relation(fields: [transaction_id], references: [id])
  accounts     accounts     @relation(fields: [account_id], references: [id])
}

model bulk_transfers {
  id                    String         @id
  initiated_by_id       String
  from_address          String
  total_amount          Int
  recipient_count       Int
  created_at            DateTime       @default(now())
  campaign_name         String
  distribution_category String
  wallets               wallets        @relation(fields: [from_address], references: [address])
  users                 users          @relation(fields: [initiated_by_id], references: [id])
  transactions          transactions[]
}

model mint_burn_events {
  id        String       @id
  amount    Int
  type      MintBurnType
  timestamp DateTime     @default(now())
  reason    String
}

model otps {
  email      String   @id
  code       String
  created_at DateTime @default(now())
  expires_at DateTime
  attempts   Int      @default(0)
}

model signup_otps {
  email      String   @id
  code       String
  created_at DateTime @default(now())
  expires_at DateTime
  attempts   Int      @default(0)
}

model reset_password_otps {
  email      String   @id
  code       String
  created_at DateTime @default(now())
  expires_at DateTime
  attempts   Int      @default(0)
}

model signup_setup_tokens {
  id         String   @id @default(uuid())
  userId     String
  expires_at DateTime
  used       Boolean  @default(false)
  users      users    @relation(fields: [userId], references: [id])
}

model transactions {
  id                                         String          @id
  created_at                                 DateTime        @default(now())
  amount                                     Int
  reference                                  String?         @unique
  reason                                     String
  timestamp                                  DateTime        @default(now())
  initiated_by_id                            String
  from_address                               String
  to_address                                 String
  from_account_id                            String?
  to_account_id                              String?
  bulk_transfer_id                           String?
  bulk_transfers                             bulk_transfers? @relation(fields: [bulk_transfer_id], references: [id])
  wallets_transactions_from_addressTowallets wallets         @relation("transactions_from_addressTowallets", fields: [from_address], references: [address])
  users                                      users           @relation(fields: [initiated_by_id], references: [id])
  wallets_transactions_to_addressTowallets   wallets         @relation("transactions_to_addressTowallets", fields: [to_address], references: [address])
  accounts_from                              accounts?       @relation("account_from", fields: [from_account_id], references: [id])
  accounts_to                                accounts?       @relation("account_to", fields: [to_account_id], references: [id])

  ledger_lines ledger_entries[]
}

model treasuries {
  id                   String                 @id
  vault_name           String
  purpose              String
  created_by_id        String
  created_at           DateTime               @default(now())
  deactivated_at       DateTime?
  is_active            Boolean                @default(true)
  users                users                  @relation(fields: [created_by_id], references: [id])
  treasury_signatories treasury_signatories[]
  wallets              wallets?
}

model treasury_signatories {
  signatory_id String
  treasury_id  String
  added_at     DateTime   @default(now())
  users        users      @relation(fields: [signatory_id], references: [id])
  treasuries   treasuries @relation(fields: [treasury_id], references: [id])

  @@id([signatory_id, treasury_id])
}

model users {
  id                   String                 @id
  name                 String
  email                String                 @unique
  phone                String                 @unique
  birthday             DateTime               @db.Date
  academic_status      AcademicStatus
  space                Space
  tribe                Tribe?
  schools_attended     School[]
  pin_hash             String?
  is_admin             Boolean                @default(false)
  member_since_year    Int
  member_since_month   Int
  is_active            Boolean                @default(true)
  deactivated_at       DateTime?
  created_at           DateTime               @default(now())
  updated_at           DateTime
  bulk_transfers       bulk_transfers[]
  transactions         transactions[]
  treasuries           treasuries[]
  treasury_signatories treasury_signatories[]
  wallets              wallets?
  sessions             Session[]
  signup_setup_tokens  signup_setup_tokens[]
  accounts             accounts[]
  favorites            user_favorites[]       @relation("user_favorites")
  favorited_by         user_favorites[]       @relation("favorited_by")
}

model user_favorites {
  user_id     String
  favorite_id String

  created_at DateTime @default(now())

  user     users @relation("user_favorites", fields: [user_id], references: [id], onDelete: Cascade)
  favorite users @relation("favorited_by", fields: [favorite_id], references: [id], onDelete: Cascade)

  @@id([user_id, favorite_id])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model wallets {
  address                                         String           @id
  balance                                         Int              @default(0)
  created_at                                      DateTime         @default(now())
  owner_user_id                                   String?          @unique
  owner_treasury_id                               String?          @unique
  bulk_transfers                                  bulk_transfers[]
  transactions_transactions_from_addressTowallets transactions[]   @relation("transactions_from_addressTowallets")
  transactions_transactions_to_addressTowallets   transactions[]   @relation("transactions_to_addressTowallets")
  treasuries                                      treasuries?      @relation(fields: [owner_treasury_id], references: [id])
  users                                           users?           @relation(fields: [owner_user_id], references: [id])
}

enum AcademicStatus {
  Student
  Graduate
}

enum MintBurnType {
  Mint
  Burn
}

enum School {
  Selling
  Impact
  Influence
}

enum Space {
  Onboarding
  Lounge
  Bridge
  Citadel
}

enum Tribe {
  Tech
  Creative
  Business
  Impact
}

enum AccountType {
  USER
  TREASURY
  SYSTEM
}
